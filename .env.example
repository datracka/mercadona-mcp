# OpenAI runtime API key with Tunnels Read + Use permission.
API_KEY=

# Tunnel ID from OpenAI Platform (an identifier, not a second API key).
TUNNEL_ID=

# Optional: required only for mercadona_get_cart.
# Copy the full Authorization header value from your own Mercadona session.
# Include its original scheme/prefix; no automatic Bearer/Token prefix is added.
MERCADONA_AUTHORIZATION=
MERCADONA_CUSTOMER_ID=
